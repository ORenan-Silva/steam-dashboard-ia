{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|Discordbot|Twitterbot|facebookexternalhit|Facebot|TelegramBot|Slackbot|LinkedInBot|SkypeUriPreview|redditbot|Embedly).*"
        }
      ],
      "dest": "/api/compartilhar"
    },
    { "handle": "filesystem" },
    { "src": "/(privacidade|termos|seus-dados)/?", "dest": "/index.html" }
  ]
}
