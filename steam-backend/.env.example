# Copie este arquivo para .env e preencha com as suas chaves
# Chave da Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=COLE_AQUI_A_SUA_CHAVE_DA_STEAM
# Chave do Groq (IA da SteamBB): https://console.groq.com/keys
GROQ_API_KEY=COLE_AQUI_A_SUA_CHAVE_DO_GROQ
# Opcional: modelo da IA (padrão openai/gpt-oss-120b). Lista: https://console.groq.com/docs/models
GROQ_MODEL=
PORT=3001
# Em produção: endereço do frontend (ex: https://steambb.vercel.app). Deixe vazio em dev.
FRONTEND_URL=
# Opcional: mensagens por minuto que cada visitante pode mandar para a IA (padrão 10)
CHAT_LIMIT_PER_MINUTE=
